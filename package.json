{
  "name": "gemini-desktop-for-linux",
  "productName": "Gemini",
  "version": "1.0.0",
  "description": "Lightweight Electron desktop wrapper for Google Gemini on Linux",
  "main": "src/main.js",
  "license": "MIT",
  "repository": {
    "type": "git",

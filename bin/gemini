#!/usr/bin/env bash
set -euo pipefail

GEMINI_HOME="${GEMINI_HOME:-$HOME/.local/opt/gemini}"
GEMINI_BIN="${GEMINI_BIN:-$GEMINI_HOME/gemini}"

if [ ! -x "$GEMINI_BIN" ]; then
  echo "Error: Gemini runtime not found at $GEMINI_BIN" >&2
  echo "Run ./scripts/install.sh first, or set GEMINI_HOME." >&2
  exit 1
fi

if [ -n "${WAYLAND_DISPLAY:-}" ] && [ "${GEMINI_FORCE_X11:-0}" != "1" ]; then
  exec "$GEMINI_BIN" \
    --ozone-platform=wayland \
    --enable-wayland-ime \
    --wayland-text-input-version=3 \
    "$@"
else
  exec "$GEMINI_BIN" "$@"
fi
